<%= turbo_stream_from @task %>
<%= tag.div(data: { controller: "wallflower--catch-up" }) %>
<%= ui_page(max_width: :md) do %>
  <h1><%= @task.kind_title %></h1>
  <%= render "wallflower/tasks/live", task: @task %>
  <% if @task.status == "finished" %>
    <p id="<%= dom_id(@task, :outcome) %>"><%= @task.changed_count %> changed, <%= @task.refusals.size %> refused</p>
    <% if @task.refusals.any? %>
      <div id="<%= dom_id(@task, :refusals) %>">
        <%= ui_data_table(items: @task.refusals.order(:id), columns: [ { label: "Row" }, { reason: "Reason" } ]) %>
      </div>
    <% end %>
  <% end %>
  <% if @task.status == "finished" && @task.result_url.present? %>
    <%= ui_button(label: "Open report", href: @task.result_url, variant: :secondary) %>
  <% end %>
  <% if @task.status == "finished" && @task.result_file.attached? %>
    <%= ui_button(label: "Download", href: download_task_path(@task), variant: :secondary) %>
  <% end %>
<% end %>

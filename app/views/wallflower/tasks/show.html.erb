<%= turbo_stream_from @task %>
<%= ui_page(max_width: :md) do %>
  <h1><%= @task.kind_title %></h1>
  <p id="<%= dom_id(@task, :status) %>"><%= @task.status.humanize %></p>
  <div id="<%= dom_id(@task, :progress) %>">
    <% if @task.total %>
      <%= ui_progress(value: @task.done, max: @task.total, label: "#{@task.done} of #{@task.total}") %>
    <% end %>
  </div>
<% end %>

<%= ui_page(max_width: :md) do %>
  <h1>Tasks</h1>
  <% @tasks.each do |task| %>
    <div data-task-row>
      <%= turbo_stream_from task %>
      <%= link_to task.kind_title, task_path(task) %>
      <%= render "wallflower/tasks/live", task: task %>
      <p>Started <%= task.created_at.strftime("%b %-d, %Y") %></p>
    </div>
  <% end %>
<% end %>
